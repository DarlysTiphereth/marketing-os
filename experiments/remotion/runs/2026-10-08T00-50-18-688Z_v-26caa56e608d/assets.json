  "voice_lines": [
    {
      "scene_id": "hook-c",
      "text": "O que esse galão azul faz pela sua roupa?",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "ca3db0222fed2e93dffc",
      "cached": true,
      "seconds": 3.046
    },
    {
      "scene_id": "b1-problem",
      "text": "Sujeira que não sai. Cheiro que não fica.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "19e9b3c39f284ee9b5e8",
      "cached": false,
      "seconds": 3.817
    },
    {
      "scene_id": "b1-tension",
      "text": "E lá vai você: esfregar, enxaguar… e torcer pra dar certo.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "2ee4e415ffb7383d7fd5",
      "cached": false,
      "seconds": 4.914
    },
    {
      "scene_id": "b1-reveal",
      "text": "GRAND Sabão Líquido Premium. Fórmula avançada para remoção de manchas, e cuidado com as cores.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "cfdb0b11b72624c37575",
      "cached": true,
      "seconds": 7.137
    },
    {
      "scene_id": "b1-howto",
      "text": "Na máquina, use puro ou diluído. À mão, dilua em água e aplique.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "cee4f936e7db054d1829",
      "cached": false,
      "seconds": 5.505
    },
    {
      "scene_id": "b1-benefits",
      "text": "Remove as sujeiras. Deixa as roupas mais limpas e perfumadas. E cuida das suas roupas.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "d5d6c6156f8124223da1",
      "cached": true,
      "seconds": 7.363
    },
    {
      "scene_id": "b1-payoff",
      "text": "Limpeza profunda… num galão de cinco litros.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "a20ce39e2d3e50154cb5",
      "cached": true,
      "seconds": 3.677
    },
    {
      "scene_id": "cta-b",
      "text": "Encomende já o seu galão de cinco litros.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Daniel",
      "source_rate_hz": 16000,
      "cache_key": "e99f188308980dce14b0",
      "cached": false,
      "seconds": 3.055
    }
  ],

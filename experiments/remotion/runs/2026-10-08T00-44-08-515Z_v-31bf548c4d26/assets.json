  "voice_lines": [
    {
      "scene_id": "hook-a2",
      "text": "Roupa saindo sem cheiro de limpa?",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "4be25fcf6bd86c1c5c8c",

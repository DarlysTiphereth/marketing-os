  "voice_lines": [
    {
      "scene_id": "hook-a",
      "text": "Sua roupa sai da máquina… sem cheiro de limpa?",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "699c247aa3230b032512",
      "cached": true,
      "seconds": 4.28
    },
    {
      "scene_id": "b1-problem",
      "text": "Sujeira que não sai. Cheiro que não fica.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "dcfd115dc23bcae805ef",
      "cached": true,
      "seconds": 4.465
    },
    {
      "scene_id": "b1-tension",
      "text": "E lá vai você: esfregar, enxaguar… e torcer pra dar certo.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "f9c6b2c6ecaeeb0f21c7",
      "cached": true,
      "seconds": 5.81
    },
    {
      "scene_id": "b1-reveal",
      "text": "GRAND Sabão Líquido Premium. Fórmula avançada para remoção de manchas, e cuidado com as cores.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "4d1dbe3e848ce6cd08df",
      "cached": true,
      "seconds": 8.42
    },
    {
      "scene_id": "b1-howto",
      "text": "Na máquina, use puro ou diluído. À mão, dilua em água e aplique.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "cec120ea58a3acf23b1b",
      "cached": true,
      "seconds": 6.465
    },
    {
      "scene_id": "b1-benefits",
      "text": "Remove as sujeiras. Deixa as roupas mais limpas e perfumadas. E cuida das suas roupas.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "e246cd6d0986519e253b",
      "cached": true,
      "seconds": 8.59
    },
    {
      "scene_id": "b1-payoff",
      "text": "Limpeza profunda… num galão de cinco litros.",
      "provider": "windows-onecore-local",
      "voice": "Microsoft Maria",
      "source_rate_hz": 16000,
      "cache_key": "df6b6d3e3194febbcd4a",
      "cached": true,
      "seconds": 4.315
    },
    {
      "scene_id": "cta-a",
